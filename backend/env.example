# Скопируйте в .env:  cp .env.example .env
# Файл .env не коммитить.

# --- PostgreSQL (используется контейнером db и docker-compose) ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=app_db
POSTGRES_PORT=5432
POSTGRES_HOST=db
# --- Приложение при запуске вне Docker (в compose собирается из POSTGRES_*) ---
DATABASE_URL=postgresql+asyncpg://app_user:change_me@localhost:5432/app_db

# --- SMTP (в compose — Mailpit: SMTP 1025, веб-интерфейс http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=notetaker@example.com


JWT_SECRET_KEY=your_key
SECRET_KEY=your_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30